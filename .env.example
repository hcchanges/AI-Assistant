# 复制为 .env 并填入你自己的值，.env 已被 gitignore
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://your-endpoint
OCR_LANG=chinese

# ---------- 情绪判定后端（v2-social-emotion-backend）----------
# 留空 = 自动：有 JEV_API_KEY 走 jev，有主聊天 LLM key 走 llm，否则 local。
# 可强制：jev / llm / local（强制的那档没钥匙时自动退回 local）。
# 设为 jev / llm 即启用对应后端（monitor 接线）；留空 = 沿用本地默认（不触发）。
# EMOTION_BACKEND=
# Jev 后端的钥匙与地址（真实 endpoint / 认证待补；没配就自动跳过）。
# JEV_API_KEY=
# JEV_ENDPOINT=
